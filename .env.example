# ---------- Stream Chat ----------
# Public API key (also used client-side)
NEXT_PUBLIC_STREAM_API_KEY=<your_stream_key>
# Same as above but without NEXT_PUBLIC_ for server code
STREAM_KEY=<your_stream_key>
# Secret: server-only (NEVER commit a real value)
STREAM_SECRET=<your_stream_secret>

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=<https://xxxx.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your_anon_key>        # client-safe
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>    # server-only
SUPABASE_DB_URL=<postgresql://user:pass@host:5432/dbname>  # server-only; used by Prisma/pg/etc.

# Optional if you verify JWTs yourself (not required for basic usage)
SUPABASE_JWT_SECRET=<your_project_jwt_secret>

# ---------- Letta ----------
LETTA_API_KEY=<your_letta_key>        # server-only
LETTA_AGENT_ID=<your_agent_id>        # optional if you bind at runtime
# If using cloud URL, you can omit; defaults can live in code
LETTA_BASE_URL=<https://api.letta.ai> # or (cloud)

# ---------- Janitor (optional) ----------
JANITOR_BASE_URL=https://janitorai.com/hackathon/completions
JANITOR_API_KEY=<your_janitor_key>    # server-only